# Copy to .env.local and fill in from Supabase: Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Developer Super Admin key (optional, can also be entered directly in the portal)
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Developer Admin PIN (default fallback is 1996 if unset)
VITE_DEV_ADMIN_PIN=1996